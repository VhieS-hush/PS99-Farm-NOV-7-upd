-- =====================
-- ANTI-AFK
-- =====================
local function startAntiAFK()
    task.spawn(function()
        while Config.AntiAFK do
            pcall(function()
                local VirtualUser = game:GetService("VirtualUser")
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
            task.wait(60)
        end
    end)
end

-- =====================
-- MAIN FARM LOOP
-- =====================
local farmActive = false
local function startFarm()
    if farmActive then return end
    farmActive = true
    task.spawn(function()
        while farmActive do
            pcall(function()
                if Config.AutoBreak then
                    farmBreakables()
                end
                if Config.AutoCombine then
                    autoCombine()
                end
                if Config.AutoMasqueradeGames then
                    joinMasqueradeGame()
                end
                if Config.AutoRebirth then
                    autoRebirth()
                end
            end)
            task.wait(0.1)
        end
    end)
end
local function stopFarm()
    farmActive = false
end

