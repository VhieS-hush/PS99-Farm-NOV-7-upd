-- =====================
-- SERVICES / REMOTES
-- =====================
local function getRemote(name)
    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        or game:GetService("ReplicatedStorage"):FindFirstChild("RE")
    if remotes then
        return remotes:FindFirstChild(name)
    end
    return nil
end

local function getModule(name)
    return require(game:GetService("ReplicatedStorage"):FindFirstChild(name, true))
end

-- =====================
-- TELEPORT HELPER
-- =====================
local function teleportTo(pos)
    if HumanoidRootPart then
        HumanoidRootPart.CFrame = CFrame.new(pos)
    end
end

-- =====================
-- AUTO BREAK LOOP
-- =====================
local function getBreakables()
    local results = {}
    -- PS99 breakables are tagged or found in Workspace > Areas
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (
            obj.Name:find("Breakable") or
            obj.Name:find("Coin") or
            obj.Name:find("Gem") or
            obj.Name:find("Chest") or
            obj.Name:find("Egg")
        ) then
            local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primary then
                results[#results + 1] = { model = obj, part = primary }
            end
        end
    end
    return results
end

local function farmBreakables()
    local breakRemote = getRemote("BreakObject") or getRemote("BreakBubble") or getRemote("BreakObstacle")
    local collectRemote = getRemote("CollectCoins") or getRemote("CollectDrop")

    local breakables = getBreakables()
    if #breakables == 0 then return end

    for _, item in ipairs(breakables) do
        if not Config.AutoBreak then break end
        if item.part and item.part.Parent then
            if Config.TeleportToBreakables then
                teleportTo(item.part.Position + Vector3.new(0, 3, 0))
            end
            if breakRemote then
                pcall(function() breakRemote:FireServer(item.model) end)
            else
                -- Fallback: touch the breakable
                pcall(function()
                    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if HRP then
                        HRP.CFrame = CFrame.new(item.part.Position + Vector3.new(0, 2, 0))
                    end
                end)
            end
            task.wait(Config.BreakDelay)
        end
    end

    -- Auto collect drops
    if Config.AutoCollect then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name == "Drop" or obj.Name == "Coin" or obj.Name == "Gem") then
                if collectRemote then
                    pcall(function() collectRemote:FireServer(obj) end)
                else
                    local dist = (HumanoidRootPart.Position - obj.Position).Magnitude
                    if dist <= Config.CollectRadius then
                        teleportTo(obj.Position)
                    end
                end
            end
        end
    end
end

